# Netlify Functions scope only. Never use public build variables for these values.
# Option 1: use the same private workbook endpoint that updates Google Drive.
BIG_FORMS_URL=https://bigforms.texasourlittlemiss.net
WORKBOOK_DOWNLOAD_KEY=
# Option 2: a dedicated JSON feed with only approved scheduling fields.
ROSTER_FEED_URL=
ROSTER_FEED_TOKEN=
# Queens shared-password access. Set these as secret, Functions-scoped variables.
# QUEENS_PASSWORD_HASH format: scrypt$<32 hex salt>$<128 hex derived key>
# QUEENS_SESSION_SECRET: at least 64 random characters. Never put the password in source.
QUEENS_PASSWORD_HASH=
QUEENS_SESSION_SECRET=
